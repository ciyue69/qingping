<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.qingping">

    <!-- 1. 获取已安装应用包名与名称（用于将包名解析为可读 APP 名称并按应用统计） -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <!-- 2. 开机广播监听权限（支持设备重启后拉起前台守护服务） -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- 3. 前台常驻服务与通知权限（Android 9+ / Android 13+ / Android 14+ 特殊用途前台服务） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 4. 请求加入电池优化白名单权限（降低系统 Doze 模式杀后台概率） -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:allowBackup="true"
        android:label="清屏"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <!-- 主界面：统计看板与权限配置引导 -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 核心无障碍服务：系统级绑定，具备高进程优先级 -->
        <service
            android:name=".QingPingAccessibilityService"
            android:exported="false"
            android:label="清屏广告与跳转拦截服务"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- 前台常驻保活服务 -->
        <service
            android:name=".KeepAliveForegroundService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="守护无障碍广告拦截服务稳定运行并提供实时状态通知" />
        </service>

        <!-- 开机自启广播接收器 -->
        <receiver
            android:name=".BootCompletedReceiver"
            android:directBootAware="true"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
